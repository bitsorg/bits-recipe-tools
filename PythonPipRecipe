# PythonPipRecipe — recipe for pure-Python packages installed from PyPI
#
# Installs the package by running:
#   python -m pip install <PYPI_NAME>==<PKGVERSION>
#
# No source tarball is required; omit the `sources:` field in the recipe header.
# The package name passed to pip is derived from PKGNAME (set by bits from the
# `package:` field).  pip normalises underscores and hyphens, so both forms work.
#
# When the PyPI package name differs from the bits package name, set PYPI_NAME
# in the recipe before or after the bits-include line, e.g.:
#   PYPI_NAME="python-prctl"
#   . $(bits-include PythonPipRecipe)
# PYPI_NAME overrides the default (PKGNAME) only for the pip install call;
# all other bits machinery continues to use PKGNAME.
#
# Requirement: Python must be in the recipe's `requires:` list so that
# Python_ROOT is set in the environment before this file is sourced.

. ${BITS_RECIPE_TOOLS_ROOT}/PythonRecipe

# If pip cannot find a matching binary wheel it falls back to building the
# package from source in an isolated build.  Such builds (ninja for torch-style
# C++/CUDA extensions, CMake for scikit-build packages, plain setuptools/make
# for the rest) otherwise spawn one compile process per core, ignoring $JOBS —
# multiplied again by every concurrent --builders slot.  Bound them to $JOBS,
# which bits has already divided across the active builders (see
# bits_helpers/memory.effective_jobs).  These exports are harmless no-ops when
# pip installs a prebuilt wheel, and apply to recipes that override MakeInstall
# (e.g. torch) because they are set at recipe-source time, before any step runs.
if [ -n "${JOBS}" ]; then
  export MAX_JOBS="${JOBS}"                                 # ninja-based extensions (torch, …)
  export CMAKE_BUILD_PARALLEL_LEVEL="${JOBS}"               # scikit-build / CMake extensions
  export MAKEFLAGS="${MAKEFLAGS:+${MAKEFLAGS} }-j${JOBS}"   # setuptools/distutils + make
fi

# No source tarball: skip the rsync Prepare step
function Prepare() { true; }

function MakeInstall() {
  mkdir -p "${SITE_PACKAGES}"
  # PYPI_NAME may be set by the recipe to override the PyPI package name when
  # it differs from the bits package name (e.g. PYPI_NAME="python-prctl").
  local _pip_name="${PYPI_NAME:-${PKGNAME}}"
  # BITS_PIP_BUILD (the group's system.pip_build, or bits build --pip-build):
  # source builds this package from its sdist; all builds its build tools too
  local _binary=()
  case "${BITS_PIP_BUILD:-}" in
    source) _binary=(--no-binary "${_pip_name}") ;;
    all)    _binary=(--no-binary :all:) ;;
  esac
  # BITS_PIP_PIN "<file> <sha256>" (bits: what the first build installed): only
  # that file, by its hash, so a file uploaded later is never taken instead
  local _req=("${_pip_name}==${PKGVERSION}")
  if [ -n "${BITS_PIP_PIN:-}" ]; then
    printf '%s==%s --hash=sha256:%s\n' "${_pip_name}" "${PKGVERSION}" "${BITS_PIP_PIN##* }" > "${BUILDDIR}/pip-pin.txt"
    _req=(--require-hashes -r "${BUILDDIR}/pip-pin.txt")
  fi
  # --no-deps             deps are managed by bits, not pip
  # --no-build-isolation  build tools from Python and the recipe's requires, as bits built them
  # --ignore-installed    never uninstall a system copy ("Permission denied")
  # --report              what pip installed, for .pip-source.json (bits pins it)
  # --root=/ --prefix=    install directly into our package tree; no staging dir
  "${PYTHON_EXE}" -m pip install \
    --no-deps --no-build-isolation --ignore-installed ${_binary[@]+"${_binary[@]}"} \
    --report "${BUILDDIR}/pip-report.json" \
    --root=/ --prefix="${INSTALLROOT}" \
    "${_req[@]}"
  # Verify pip actually installed something — catches silent failures where pip
  # exits 0 but the package was not found or the index was unreachable.
  if [ -z "$(ls -A "${SITE_PACKAGES}" 2>/dev/null)" ]; then
    echo "PythonPipRecipe: pip exited 0 but ${SITE_PACKAGES} is empty" >&2
    echo "PythonPipRecipe: check that ${_pip_name}==${PKGVERSION} exists on the configured index" >&2
    return 1
  fi
  # The file pip installed and its sha256, from its report: bits pins and records it
  "${PYTHON_EXE}" - "${BUILDDIR}/pip-report.json" "${INSTALLROOT}/.pip-source.json" <<\EOF
import json, sys
d = json.load(open(sys.argv[1]))["install"][0]["download_info"]
h = d.get("archive_info", {}).get("hashes", {}).get("sha256")
json.dump({"url": d["url"], "file": d["url"].rsplit("/", 1)[-1], "sha256": h}, open(sys.argv[2], "w"))
EOF
}
