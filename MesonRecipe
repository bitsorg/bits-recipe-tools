# MesonRecipe — Meson-based packages (bits-recipe-tools)
#
# Overrideable variables:
#   MESON_BUILDDIR        build subdir (default: _build)
#   MESON_EXTRA_OPTIONS   extra flags for `meson setup`
#
# Override Configure() for package flags (call _meson_fixenv first if the
# override does not go through the default path).

. ${BITS_RECIPE_TOOLS_ROOT}/BitsRecipe

MESON_BUILDDIR="${MESON_BUILDDIR:-_build}"

# meson was pip-installed into MESON_ROOT with the bits Python shebang, but that
# Python's sys.path lacks MESON_ROOT's site-packages. Put mesonbuild on
# PYTHONPATH at every meson invocation (build-execution time, not just at recipe
# source time).
function _meson_fixenv() {
  if [ -n "${MESON_ROOT}" ]; then
    local _pyver
    _pyver=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null)
    export PYTHONPATH="${MESON_ROOT}/lib/python${_pyver}/site-packages${PYTHONPATH:+:${PYTHONPATH}}"
  fi
}

function Prepare() {
  # PYTHONPATH early so mesonbuild is importable in every later phase, including
  # custom Configure() overrides that do not call _meson_fixenv themselves.
  _meson_fixenv
  rsync -av --delete --exclude '**/.git' --delete-excluded "${SOURCEDIR}"/ ./
}

function Configure() {
  _meson_fixenv
  # --libdir=lib keeps libs and pkgconfig in $prefix/lib (not a multiarch path
  # like lib/x86_64-linux-gnu), so all *_ROOT/lib/pkgconfig assumptions hold.
  meson setup "${MESON_BUILDDIR}" --prefix="$INSTALLROOT" --libdir=lib ${MESON_EXTRA_OPTIONS}
}

function Make() {
  _meson_fixenv
  meson compile -C "${MESON_BUILDDIR}"
}

function MakeInstall() {
  _meson_fixenv
  meson install -C "${MESON_BUILDDIR}"
}
