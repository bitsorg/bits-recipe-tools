# AutoToolsRecipe — autoconf/automake packages (bits-recipe-tools)
#
# The build pipeline lives in BitsRecipe; override Configure() for extra flags:
#
#   function Configure() {
#     [ -f autogen.sh ] && ./autogen.sh
#     ./configure --prefix="$INSTALLROOT" --enable-foo
#   }

. ${BITS_RECIPE_TOOLS_ROOT}/BitsRecipe

function Configure() {
  [ -f autogen.sh ] && ./autogen.sh
  ./configure --prefix="$INSTALLROOT"
}

function Make() {
  make ${JOBS:+-j $JOBS}
}

function MakeInstall() {
  make install
}
