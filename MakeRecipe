# MakeRecipe — plain-make packages, no configure step (bits-recipe-tools)
#
# Configure is a no-op (inherited from BitsRecipe). Override Make()/MakeInstall()
# as needed; SOURCEDIR/INSTALLROOT/JOBS are available (guard JOBS with
# ${JOBS:+-j$JOBS}). Typical non-standard install:
#
#   function Make() {
#     make ${JOBS:+-j $JOBS}
#     make install PREFIX="$INSTALLROOT"
#   }
#   function MakeInstall() { true; }

. ${BITS_RECIPE_TOOLS_ROOT}/BitsRecipe

function Make() {
  make ${JOBS:+-j $JOBS}
}

function MakeInstall() {
  make install PREFIX="${INSTALLROOT}"
}
